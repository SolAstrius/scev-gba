+/* SCEV: skip-BIOS boot. Sets registers to the post-splash state
+ * documented in GBATEK §3.2 and reloads the pipeline from the cart
+ * entry point. Used by the bare-metal port to avoid the BIOS splash
+ * (which currently hangs on at least one cart we've tested under
+ * upstream gdkGBA — under investigation; this gets games running
+ * meanwhile).
+ *
+ * Mirrors mGBA / VBA / no$gba's "skip BIOS" flow. */
+void arm_skip_bios(void) {
+    for (int i = 0; i < 16; i++) arm_r.r[i] = 0;
+    /* Banked stacks for the modes the cart will switch through. */
+    arm_r.r13_usr = 0x03007F00;
+    arm_r.r13_irq = 0x03007FA0;
+    arm_r.r13_svc = 0x03007FE0;
+    arm_r.r14_usr = 0;
+    arm_r.r14_irq = 0;
+    arm_r.r14_svc = 0;
+    arm_r.cpsr    = 0x0000001F;   /* system mode, IRQs enabled, ARM */
+    /* Active r[13] mirrors the bank for the current mode (system →
+     * uses the user bank). Without this the cart's first dozen
+     * instructions run with sp=0 and any stack op writes to BIOS /
+     * 0-region, which silently corrupts state. */
+    arm_r.r[13]   = arm_r.r13_usr;
+    arm_r.r[14]   = arm_r.r14_usr;
+    arm_r.r[15]   = 0x08000000;
+    arm_load_pipe();              /* fetch the cart's entry instr pair */
 }
