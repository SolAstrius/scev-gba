+/* SCEV: trace the first N executed instructions. main.c arms this
+ * by writing scev_trace_remaining = N before letting arm_exec run.
+ * Format: ARM/THUMB tag, PC of executing instr (r[15]-8 ARM,
+ * r[15]-4 THUMB), opcode, r0..r3, sp, lr. Routed through a callback
+ * the firmware installs to keep arm.c free of UART deps. */
+extern volatile int scev_trace_remaining;
+extern void (*scev_trace_cb)(int thumb, uint32_t pc, uint32_t op,
+                             uint32_t r0, uint32_t r1, uint32_t r2, uint32_t r3,
+                             uint32_t sp, uint32_t lr);
+
 static void t16_step() {
+    /* Trace BEFORE the new fetch — at this point r[15] is PC+4 of
+     * the executing Thumb instruction. */
+    if (scev_trace_remaining > 0 && scev_trace_cb) {
+        scev_trace_remaining--;
+        scev_trace_cb(1, arm_r.r[15] - 4, arm_op,
+                      arm_r.r[0], arm_r.r[1], arm_r.r[2], arm_r.r[3],
+                      arm_r.r[13], arm_r.r[14]);
+    }
     arm_pipe[1] = arm_fetchh(SEQUENTIAL);
 
     thumb_proc[arm_op >> 5]();
