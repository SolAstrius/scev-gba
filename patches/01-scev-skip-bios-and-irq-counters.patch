+/* SCEV diag: count writes to the IWRAM tail region (0x7F00-0x7FFF)
+ * — the BIOS scratchpad / IRQ flags. If trigger=N per second but
+ * scev_iwram_top_writes stays 0, BIOS isn't touching the standard
+ * 0x03007FF8 location and is using a different mechanism. */
+extern volatile uint32_t scev_iwram_top_writes;
+extern volatile uint16_t scev_iwram_last_addr;
+extern volatile uint8_t  scev_iwram_last_val;
 static void iwram_write(uint32_t address, uint8_t value) {
     iwram[address & 0x7fff] = value;
+    if ((address & 0x7fff) >= 0x7F00) {
+        scev_iwram_top_writes++;
+        scev_iwram_last_addr = (uint16_t)(address & 0xFFFF);
+        scev_iwram_last_val  = value;
+    }
 }
 
